# ShinGan 設定ファイル
# このファイルをコピーして .env にリネームし、値を設定してください。

# === API キー ===
# Google AI Studio で取得: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# === モデル設定 ===
# gemini-3-pro-image-preview (Nano Banana Pro) / gemini-2.5-flash-image (Flash)
SHINGAN_MODEL=gemini-3-pro-image-preview
SHINGAN_FALLBACK_MODEL=gemini-2.5-flash-image

# === 生成デフォルト ===
SHINGAN_RESOLUTION=2K
SHINGAN_ASPECT_RATIO=1:1
SHINGAN_THINKING=true

# === サーバー設定 ===
SHINGAN_HOST=0.0.0.0
SHINGAN_PORT=8080

# === リトライ設定 ===
SHINGAN_MAX_RETRIES=4
SHINGAN_RETRY_DELAY=2.0

# === 出力 ===
SHINGAN_OUTPUT_DIR=output
